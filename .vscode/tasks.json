{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "STM32: 检查全部代码",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/check-project.ps1",
                "-WorkspaceRoot",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "检查 IAR 工程清单中的全部 C 源文件，不烧录程序。"
        }
    ]
}
