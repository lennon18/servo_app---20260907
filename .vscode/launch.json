{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "STM32: Debug (ST-Link/OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/gcc/servo_app.elf",
            "preLaunchTask": "STM32: Start OpenOCD",
            "servertype": "external",
            "gdbTarget": "localhost:50000",
            "armToolchainPath": "C:/Program Files (x86)/Arm GNU Toolchain arm-none-eabi/14.2 rel1/bin",
            "device": "STM32H743VI",
            "preLaunchCommands": [
                "set remotetimeout 30"
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 1
            },
            "showDevDebugOutput": "raw"
        },
        {
            "name": "STM32: Build only",
            "type": "node-terminal",
            "request": "launch",
            "preLaunchTask": "STM32: Build (GCC)",
            "command": "Write-Output 'STM32 GCC build completed.'",
            "cwd": "${workspaceFolder}"
        }
    ]
}
